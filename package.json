{
  "name": "sulog",
  "version": "1.0.0",
  "private": true,
  "description": "Sulog \u2014 Waray-Waray review app (single-file, self-hosted)",
  "scripts": {
    "build": "bash build.sh",
    "seed": "node tools/gen-pc-seed.mjs",
    "reload": "node --env-file=.env.local tools/reload-pc.mjs",
    "preview": "node --env-file=.env.local tools/gen-course-preview.mjs",
    "all": "npm run seed && npm run reload && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
