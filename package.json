{
  "name": "sulog",
  "version": "1.0.0",
  "private": true,
  "description": "Sulog — Waray-Waray review app (single-file, self-hosted)",
  "scripts": {
    "build": "bash build.sh",
    "bootstrap": "node --env-file=.env.local tools/bootstrap-db.mjs",
    "check": "node --env-file=.env.local tools/rebuild-check.mjs",
    "rls:authed": "node --env-file=.env.local tools/rls-authed-smoke.mjs",
    "course": "node tools/gen-pc-course.mjs",
    "reload": "node --env-file=.env.local tools/reload-pc.mjs",
    "preview": "node --env-file=.env.local tools/gen-course-preview.mjs",
    "all": "npm run course && npm run reload && npm run build",
    "rls": "node tools/rls-smoke.mjs",
    "harvest": "node --env-file=.env.local tools/harvest-ella.mjs",
    "harvest:spoken": "node --env-file=.env.local tools/harvest-spoken.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "pg": "^8.22.0",
    "playwright-core": "^1.61.1"
  }
}
