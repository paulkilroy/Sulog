785377224,"w":0.018796992457770056},{"x":0.12406015125386122,"y":0.46496212122195568,"t":"Buot ba kamo magkompesal han iyo mga sala?","w":0.37218044006746581,"h":0.016142529670638228},{"t":"Kinahanglan magsangyaw kifa nga tanan han Pulong ha Ginoo.","h":0.017449201357485067,"y":0.41279069773042487,"w":0.49812027675653597,"x":0.12406015614710814},{"t":"7. Kinahanglan hi Paul maghimo hin bag-o nga saad ha Dios.","w":0.49060148351332722,"x":0.093984975560065714,"h":0.0174418603531038,"y":0.36046511611705279},{"t":"• Kinahanglan nga ang mga opisyales han iglesiya magtukdaw.","x":0.10526317611891235,"h":0.01889534791310632,"w":0.49812027675653592,"y":0.30668604695551083},{"x":0.092105263621075267,"h":0.014534884028964634,"w":0.016917292588676511,"y":0.2558139533585797,"t":"9."},{"x":0.10902255993810359,"t":"P'wede ka lia magtutdo ha amon hin inga karantahon?","w":0.43609020756740191,"y":0.25436046513594801,"h":0.0174418603531038},{"t":"10. Pwede mag-ukoy hira Rey ngan Jun dinhi ha amon.","w":0.4342105341892617,"h":0.016098484848484862,"x":0.092105264648790125,"y":0.20202020194602721},{"t":"11. l'wede magsakay kamo hin sarakyan didto","x":0.092105269972595799,"w":0.36278194851345491,"y":0.15116279117426079,"h":0.018976097757166022}]}