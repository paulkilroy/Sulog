92571102,"t":"maduroto nga lalake","h":0.020348837881377202},{"t":"Particles","h":0.018164449267917271,"w":0.077336722729252821,"y":0.49527824055046521,"x":0.15963990979484435},{"w":0.75777116164662484,"h":0.023503373367617764,"x":0.15778004610323185,"t":"One of the most difficult things you learned in these lessons was the word order of the particles.","y":0.47091376206464253},{"w":0.72368417378344563,"h":0.020517676767676796,"y":0.45486111071751256,"x":0.15789476121291371,"t":"Perhaps the following summary chart will help you to remember which of these comes first."},{"t":"WORD ORDER OF PARTICLES","x":0.38345865190770539,"y":0.42005813992009378,"h":0.023255813001382242,"w":0.2781954746620327},{"h":0.019049506596844568,"t":"na + ba + liwat\/ gihapon + hin duro","w":0.28383456959443937,"y":0.40246212151070981,"x":0.39285715365829404},{"x":0.39285714296090601,"h":0.013081395264827766,"w":0.024436090506759378,"y":0.38517441874840008,"t":"pa"},{"w":0.088426627364813104,"t":"Examples","y":0.35889842235316982,"h":0.019121760069721883,"x":0.15597465697835725},{"x":0.15413534522284308,"h":0.021890415085686565,"t":"Nakadto na ba liwat hiya ha balay?","w":0.28195487128363717,"y":0.33712121236723847},{"h":0.014608292266575895,"t":"Aakadto pa ba liwat hiya ha balay","x":0.16541353547046309,"w":0.26315788817561525,"y":0.32260101015851672},{"x":0.16541353813276893,"w":0.2593984915540109,"t":"laupay na ba liwat hin duro hiya'","y":0.30523255836995977,"h":0.0174418603531038},{"x":0.15601503712355391,"t":"Makadto ka pa ba liwat ha simbahan?","y":0.2848837204246214,"w":0.3007518793243209,"h":0.020356178283691406},{"h":0.020517676767676796,"x":0.15413534847045027,"y":0.24842171725194817,"w":0.76503758648641751,"t":"REMEMBER: The personal pronoun KA is a VIP pronoun and comes before all of the particles."},{"h":0.019670332321012896,"x":0.15398625761582074,"y":0.19583343841367395,"t":"Hin duro","w":0.081125228233586755},{"x":0.15413535684982735,"w":0.74436088013493162,"h":0.01749324617