# Supabase — copy to .env.local for local dev, and set the same two in Vercel
# (Project → Settings → Environment Variables). The publishable key is public by
# design (ships in the browser); RLS protects the data. build.sh reads these and
# bakes them into the bundle; if unset it falls back to the live project defaults.
SUPABASE_URL=https://kdtzfaobcgprivsxkger.supabase.co
SUPABASE_ANON_KEY=sb_publishable_mVYVK10OZfARWUl3PcfhHQ_zHa7bVpS

# For the ingestion tools (tools/*.mjs) only — the direct Postgres connection string
# (pooler). NEVER commit the real value; it lives in gitignored .env.local.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
